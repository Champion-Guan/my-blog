# 忽略文件说明：https://help.github.com/articles/ignoring-files/

# 依赖目录
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 测试产物
/coverage
/playwright-report
/test-results

# Next.js 构建产物
/.next/
/out/

# 生产环境产物
/build

# 其他系统文件和运行数据
.DS_Store
*.pem
.backup/
data/*.db
data/*.db-shm
data/*.db-wal
data/*.bak-*
/数据/*.db
/数据/*.db-shm
/数据/*.db-wal
/数据/*.bak-*
public/uploads.backup-*
public/uploads/ok-*.svg

# 调试日志和备份
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/backups

# 环境变量文件（如确需提交，请显式取消忽略）
.env*

# Vercel 配置
.vercel

# TypeScript 生成文件
*.tsbuildinfo
next-env.d.ts
